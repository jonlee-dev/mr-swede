[Unit]
Description=Lavalink audio server
Requires=network-online.target lavalink-fetch-secrets.service
After=network-online.target lavalink-fetch-secrets.service

[Service]
Type=simple
User=lavalink
Group=lavalink
WorkingDirectory=/opt/lavalink

# Spring Boot reads ${LAVALINK_SERVER_PASSWORD} from the env at startup
# (referenced in /opt/lavalink/application.yml). EnvironmentFile= is
# how systemd loads it. The secret.env file is written by
# lavalink-fetch-secrets.service before this unit starts.
EnvironmentFile=/etc/lavalink/server.env
EnvironmentFile=/etc/lavalink/secret.env

# -Xmx1G heap is plenty for 1-3 concurrent voice channels at
# Opus quality 10. Bump if we see frequent GCs in logs.
ExecStart=/usr/bin/java -Xmx1G -jar /opt/lavalink/Lavalink.jar

Restart=on-failure
RestartSec=10
TimeoutStopSec=30

# Lavalink writes plugin downloads + logs to its WorkingDirectory; the
# user must own /opt/lavalink. Created by the startup-script.

[Install]
WantedBy=multi-user.target
