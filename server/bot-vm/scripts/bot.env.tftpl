# Static env vars for the bot. TF-templated at gcp-bot-vm apply
# time; values reflect the module's input variables. Secrets are
# NOT in this file -- they land in /etc/bot/secrets.env via
# bot-fetch-secrets.service at boot.

ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO

DISCORD_BOT_NAME=${discord_bot_name}
DISCORD_GUILD_ID=${discord_guild_id}
DISCORD_SECRET_PATH=${discord_secret_path}

GCP_PROJECT_ID=${gcp_project_id}

# /valheim cog target.
VALHEIM_INSTANCE_NAME=${valheim_instance_name}
VALHEIM_ZONE=${valheim_zone}
VALHEIM_STATUS_HTTP_PORT=${valheim_status_http_port}
VALHEIM_PASSWORD_SECRET_PATH=${valheim_password_secret_path}

# /music cog target. LAVALINK_HOST=localhost short-circuits the
# cog's "ensure VM is RUNNING" dance (which made sense when
# Lavalink lived on its own VM that the bot had to start/stop;
# now Lavalink is always-on on the same VM).
LAVALINK_HOST=localhost
LAVALINK_PORT=${lavalink_port}

# These two used to drive `compute.start_instance` for the Lavalink
# VM. With LAVALINK_HOST set, the cog skips that path entirely so
# they're dead code -- but Settings still requires them, so we pass
# the now-defunct (but harmless) Lavalink VM name + zone. After we
# fully retire gcp-lavalink-vm these can be removed from the bot's
# Pydantic Settings.
LAVALINK_INSTANCE_NAME=lavalink-server
LAVALINK_ZONE=us-central1-a

MUSIC_COMMAND_CHANNEL_ID=${music_command_channel_id}

# HTTP server bind for /health, /livez, /metrics.
HOST=0.0.0.0
PORT=8080
