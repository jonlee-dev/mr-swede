# Static env vars for the bot. TF-templated at gcp-bot-vm apply
# time; values reflect the module's input variables. Secrets are
# NOT in this file -- they land in /etc/bot/secrets.env via
# bot-fetch-secrets.service at boot.

ENV=production
LOG_FORMAT=json
LOG_LEVEL=INFO

DISCORD_BOT_NAME=${discord_bot_name}
DISCORD_GUILD_ID=${discord_guild_id}
DISCORD_SECRET_PATH=${discord_secret_path}

GCP_PROJECT_ID=${gcp_project_id}

# /valheim cog target.
VALHEIM_INSTANCE_NAME=${valheim_instance_name}
VALHEIM_ZONE=${valheim_zone}
VALHEIM_STATUS_HTTP_PORT=${valheim_status_http_port}
VALHEIM_PASSWORD_SECRET_PATH=${valheim_password_secret_path}

# /music cog target. Lavalink co-tenants the bot's VM, so the bot
# connects over loopback. The port still flows through from TF so
# it stays in lockstep with the value Lavalink binds.
LAVALINK_HOST=localhost
LAVALINK_PORT=${lavalink_port}

MUSIC_COMMAND_CHANNEL_ID=${music_command_channel_id}

# HTTP server bind for /health, /livez, /metrics.
HOST=0.0.0.0
PORT=8080
