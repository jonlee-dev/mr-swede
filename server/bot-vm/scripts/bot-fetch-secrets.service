[Unit]
Description=Fetch bot secrets from Secret Manager
Requires=network-online.target
After=network-online.target
# bot.service has Requires=bot-fetch-secrets.service which makes
# starting bot trigger a fresh secret pull (failed pull -> failed
# bot start, intentional).

[Service]
Type=oneshot
ExecStart=/opt/mr-swede/scripts-bot-fetch-secrets.sh
RemainAfterExit=true
