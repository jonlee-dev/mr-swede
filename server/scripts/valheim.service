[Unit]
Description=Valheim dedicated server (docker compose)
# install-mods.service is a oneshot that drops mod .dlls into
# /opt/valheim/data/bepinex/{plugins,patchers} BEFORE this unit runs.
# Without the dependency the container would boot with an empty mods
# directory on first run; lloesche's image only copies plugins on its
# OWN startup, so mods that arrive after `docker compose up` wouldn't
# be loaded until the next container restart.
Requires=docker.service network-online.target valheim-fetch-secrets.service install-mods.service
After=docker.service network-online.target valheim-fetch-secrets.service install-mods.service

[Service]
Type=simple
WorkingDirectory=/opt/valheim
# `compose down` first so we always recreate the container with the
# current compose file. Without this, docker auto-restarts the old
# container (because compose has restart: unless-stopped) and any
# server/docker-compose.yml edit pushed via TF startup-script doesn't
# take effect until a manual recreate. The leading `-` makes the down
# non-fatal -- it'll fail on first boot when no container exists yet.
ExecStartPre=-/usr/bin/docker compose down --timeout 120
ExecStart=/usr/bin/docker compose up
ExecStop=/usr/bin/docker compose down --timeout 120
Restart=on-failure
RestartSec=10
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
