# Copy to terraform.tfvars (gitignored) and fill in.
project_id   = "your-gcp-project-id"
region       = "us-central1"
zone         = "us-central1-a"
github_owner = "your-github-username"
github_repo  = "mr-swede"

# Valheim server display name + initial world. Both can be edited later
# without forcing VM replacement (the bot rewrites /etc/valheim/world.env).
valheim_server_name   = "mr-swede-valheim"
valheim_initial_world = "default"

# Discord guild ID for instant slash-command sync. Leave empty for prod
# (commands sync globally; ~1hr propagation). Set to a test-server ID
# during dev for instant sync.
# discord_guild_id = "123456789012345678"
