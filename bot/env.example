# Mr. Swede Discord Bot - local development env vars
# Copy to .env and fill in. Production uses GSM, not this file.

# ===========================================
# Environment
# ===========================================
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console  # console | json

# ===========================================
# Google Cloud Platform
# ===========================================
GCP_PROJECT_ID=
# Override secret resource paths if you need a non-default location:
# DISCORD_SECRET_PATH=projects/<project>/secrets/discord-bot-secrets/versions/latest
# VALHEIM_PASSWORD_SECRET_PATH=projects/<project>/secrets/valheim-server-password/versions/latest

# ===========================================
# Discord
# ===========================================
DISCORD_BOT_NAME=mr-swede
DISCORD_GUILD_ID=  # Set for instant slash-command sync during dev

# Local-dev fallback: skip GSM and pass the token directly.
# DISCORD_TOKEN=your-token-here
# DISCORD_APPLICATION_ID=your-app-id

# ===========================================
# Valheim VM target (consumed by /valheim commands)
# ===========================================
VALHEIM_ZONE=us-central1-a
VALHEIM_INSTANCE_NAME=valheim-server
VALHEIM_STATUS_HTTP_PORT=9001
# Local-dev fallback: skip GSM lookup of the server password.
# VALHEIM_PASSWORD=your-server-password

# ===========================================
# Lavalink (consumed by /music * commands)
# ===========================================
LAVALINK_INSTANCE_NAME=lavalink-server
LAVALINK_ZONE=us-central1-a
# LAVALINK_HOST: empty in prod (resolved at runtime via the compute API);
# override for local dev when you have a Lavalink running on your machine.
# LAVALINK_HOST=127.0.0.1
LAVALINK_PORT=2333
# Local-dev fallback for the Lavalink password. In prod we read via
# LAVALINK_PASSWORD_SECRET_PATH from GSM.
# LAVALINK_PASSWORD=your-lavalink-password

# Discord channel ID where /music * is accepted. Empty = no restriction.
# Right-click your #bot-spam channel in Discord -> Copy Channel ID
# (you may need to enable Developer Mode in user settings).
MUSIC_COMMAND_CHANNEL_ID=

# ===========================================
# HTTP server (Cloud Run health checks)
# ===========================================
HOST=0.0.0.0
PORT=8080
