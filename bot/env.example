# Mr. Swede Discord Bot - Environment Variables
# Copy this file to .env and fill in your values for local development

# ===========================================
# Environment
# ===========================================
ENV=development
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=console  # console or json

# ===========================================
# Google Cloud Platform
# ===========================================
GCP_PROJECT_ID=749144818572

# Override secret paths if needed (defaults to project secrets)
# BLIZZARD_SECRET_PATH=projects/749144818572/secrets/blizzard-secrets/versions/latest
# DISCORD_SECRET_PATH=projects/749144818572/secrets/discord-bot-secrets/versions/latest
# SPOTIFY_SECRET_PATH=projects/749144818572/secrets/spotify-secrets/versions/latest

# ===========================================
# Discord Bot Selection
# ===========================================
# Which bot from discord-bot-secrets to use: "mr-swede" or "ow2-ranked-bot"
DISCORD_BOT_NAME=mr-swede
DISCORD_GUILD_ID=  # Optional: for faster command sync during dev
DISCORD_OWNER_ID=  # Your Discord user ID - receives cookie expiry notifications

# ===========================================
# Local Development Overrides
# If you want to run locally without GSM, uncomment and fill these:
# ===========================================
# DISCORD_TOKEN=your-token-here
# DISCORD_APPLICATION_ID=your-app-id

# BLIZZARD_CLIENT_ID=your-client-id
# BLIZZARD_CLIENT_SECRET=your-client-secret
BLIZZARD_REGION=us  # us, eu, kr, tw, cn

# SPOTIFY_CLIENT_ID=your-client-id
# SPOTIFY_CLIENT_SECRET=your-client-secret
SPOTIFY_REDIRECT_URI=http://localhost:8080/callback

# ===========================================
# Server (for Cloud Run)
# ===========================================
HOST=0.0.0.0
PORT=8080

# ===========================================
# Firestore
# ===========================================
FIRESTORE_COLLECTION_PREFIX=mr_swede_
